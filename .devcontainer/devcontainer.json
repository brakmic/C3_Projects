{
  "name": "C3 Development Environment",
  // Pinned published image; includes OpenSSH and libmicrohttpd.
  "image": "brakmic/c3dev@sha256:f73bbae2ffc2122f6694f283e8affc99e99f8730591f00b5dec6984b1ac4677d",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/host_workspace,type=bind,consistency=cached",
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true
        },
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true
      },
      "extensions": [
        "c3.vscode-c3"
      ]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/setup-workspace.mjs,target=/workspace/.devcontainer/setup-workspace.mjs,type=bind",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/c3dev/.host-ssh,type=bind,consistency=cached"
  ],
  "postAttachCommand": "bash /host_workspace/.devcontainer/setup-ssh.sh",
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "WASM demo (python http.server)" },
    "8080": { "label": "C3 web server" }
  },
  "initializeCommand": "docker network inspect devnetwork || docker network create devnetwork",
  // Docker Desktop exposes the socket as root:root 660. Add the root group so
  // c3dev can reach it. On a Linux host, match the host's docker GID instead.
  "runArgs": ["--network=devnetwork", "--group-add", "0"],
  "postCreateCommand": "node /workspace/.devcontainer/setup-workspace.mjs && mkdir -p /home/c3dev/.vscode-server && ln -sf /workspace/dev.code-workspace /home/c3dev/.vscode-server/dev.code-workspace && git config --global --add safe.directory /host_workspace && git config --global core.autocrlf input && git config --global core.filemode false",
  "remoteUser": "c3dev",
  "containerEnv": {
    "HOST_WORKSPACE": "${localWorkspaceFolder}"
  }
}
